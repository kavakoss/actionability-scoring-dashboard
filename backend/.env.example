# Wazuh Indexer (OpenSearch) credentials. Copy to .env and edit locally.
WAZUH_INDEXER_HOST=localhost
WAZUH_INDEXER_PORT=9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=change-me
WAZUH_INDEXER_SSL=true
WAZUH_INDEXER_VERIFY_CERTS=false
USE_LIVE_WAZUH=false
LIVE_HOURS_BACK=48
# Optional fixed window (ISO-8601 UTC). Set both to make an evaluation window
# reproducible, e.g. the ART run window from evaluation/runs.csv.
LIVE_FROM=
LIVE_TO=
LIVE_ALERT_LIMIT=100
LIVE_ALERT_FETCH_LIMIT=5000
# Seeds (cases) are only alerts with rule.level >= this value. Evidence for the
# case itself is retrieved from alerts + archives without a level restriction.
SEED_MIN_LEVEL=15
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
